soong_namespace {
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6750/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_WCNSS_prc_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_prc_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_prc_cfg.ini",
}

mkdir {
    name: "vendor_bt_firmware_mountpoint",
    dir: "bt_firmware",
    vendor: true,
}

mkdir {
    name: "vendor_dsp_mountpoint",
    dir: "dsp",
    vendor: true,
}

mkdir {
    name: "vendor_firmware_mnt_mountpoint",
    dir: "firmware_mnt",
    vendor: true,
}

mkdir {
    name: "vendor_fsg_mountpoint",
    dir: "fsg",
    vendor: true,
}
